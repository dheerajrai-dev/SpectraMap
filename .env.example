# .env.example — SpectraMap Environment Configuration Template
# Copy this file to .env and configure your environment-specific values.
# The .env file is strictly gitignored and must NEVER be committed to version control.

# OpenCellID API Key (Required for live external cellular tower ingestion)
# Obtain a free API key at: https://opencellid.org
OPENCELLID_API_KEY=your_opencellid_api_key_here

# Server Environment & Logging (production | development)
ENVIRONMENT=production
LOG_LEVEL=INFO

# Application Server Host & Port
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (comma-separated list, e.g. https://yourdomain.com,http://localhost:8000)
# Use * only during local development
CORS_ORIGINS=*
